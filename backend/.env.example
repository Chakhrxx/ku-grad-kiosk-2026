# Copy to .env and fill in. .env is git-ignored; this example is not, so never put real keys here.

# Required: mints the short-lived tokens the kiosk uses for Decart's realtime try-on stream
# (lucy-vton, billed per second of streaming). Get one at https://platform.decart.ai/api-keys
DECART_API_KEY=

# Base URL the QR code points to, e.g. https://kiosk.example.com. Empty: the request's own host
PUBLIC_URL=

# Most photos stored per rolling 24 hours
MAX_PER_DAY=3000

# Debug: keep each photo's steps in data/steps/ (as received from the kiosk, then framed).
# Turn off before real visitors: these copies are not deleted after 7 days.
SAVE_STEPS=false
